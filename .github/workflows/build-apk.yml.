name: Build APK
on:
  workflow_dispatch:
  push:
    branches: [main]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Unzip the project zip
        id: proj
        run: |
          ZIP=$(ls -t *.zip 2>/dev/null | head -n1)
          if [ -z "$ZIP" ]; then echo "No .zip found in repo root"; exit 1; fi
          echo "Using $ZIP"
          mkdir -p /tmp/app && unzip -q -o "$ZIP" -d /tmp/app
          PKG=$(find /tmp/app -name package.json -not -path '*/node_modules/*' | head -n1)
          if [ -z "$PKG" ]; then echo "No package.json inside zip"; exit 1; fi
          echo "dir=$(dirname "$PKG")" >> "$GITHUB_OUTPUT"

      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Use the fixed signing key (keeps your data on updates)
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          mkdir -p ~/.android
          [ -f debug.keystore ] && cp debug.keystore ~/.android/debug.keystore || true

      - name: Install and add Android
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          npm install
          npx cap add android
          npx cap sync android

      - name: Add app icon
        working-directory: ${{ steps.proj.outputs.dir }}
        run: |
          if [ -f scripts/icons.py ]; then pip install pillow && python scripts/icons.py; fi

      - name: Build APK
        working-directory: ${{ steps.proj.outputs.dir }}/android
        run: ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: app-apk
          path: ${{ steps.proj.outputs.dir }}/android/app/build/outputs/apk/debug/app-debug.apk
